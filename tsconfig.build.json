{
  "extends": "./tsconfig.json",
  // Source imports stay extensionless. The build script runs tsc-alias
  // --resolve-full-paths after tsc to add the `.js` endings that Node ESM
  // needs; `npm run check:package` fails if any built import lacks one.
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
