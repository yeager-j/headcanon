{
  "name": "headcanon",
  "version": "0.1.0",
  "description": "Optimistic mutations for Next.js: believe your writes until canon says otherwise.",
  "keywords": [
    "optimistic-updates",
    "optimistic-ui",
    "nextjs",
    "react",
    "server-actions",
    "drizzle",
    "ably"
  ],
  "author": "Jackson Yeager",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ably/channels": {
      "types": "./dist/ably/channels.d.ts",
      "default": "./dist/ably/channels.js"
    },
    "./ably/client": {
      "types": "./dist/ably/client.d.ts",
      "default": "./dist/ably/client.js"
    },
    "./ably/server": {
      "types": "./dist/ably/server.d.ts",
      "default": "./dist/ably/server.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "default": "./dist/drizzle.js"
    },
    "./drizzle-schema": {
      "types": "./dist/receipt-table.d.ts",
      "default": "./dist/receipt-table.js"
    },
    "./next/client": {
      "types": "./dist/next/client.d.ts",
      "default": "./dist/next/client.js"
    },
    "./next/server": {
      "types": "./dist/next/server.d.ts",
      "default": "./dist/next/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "drizzle"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "typecheck": "tsc --noEmit",
    "depcheck": "node depcheck.mjs",
    "check:public-api-docs": "node scripts/check-public-api-docs.mjs",
    "check:package": "publint && attw --pack . --profile esm-only",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "canonicalize": "^3.0.0",
    "serializable-result": "^0.1.0"
  },
  "peerDependencies": {
    "@testing-library/react": "^16.3.2",
    "ably": "^2.22.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "vitest": "^4.1.6"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    },
    "ably": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "ably": "^2.22.1",
    "drizzle-orm": "^0.45.2",
    "jsdom": "^29.1.1",
    "next": "16.1.6",
    "pg": "^8.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsc-alias": "^1.9.7",
    "vitest": "^4.1.6"
  }
}
